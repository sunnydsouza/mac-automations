				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>#!/bin/zsh

# If user selected a folder, create file inside it.
# If user selected a file, create file in that file's parent folder.
# If nothing is selected, fallback to current Finder window folder.

if [[ $# -gt 1 ]]; then
  osascript -e 'display alert "Create New File" message "Please select only one folder or one file."'
  exit 1
fi

if [[ $# -eq 1 ]]; then
  selected="$1"

  if [[ -d "$selected" ]]; then
    target_dir="$selected"
  else
    target_dir="$(dirname "$selected")"
  fi
else
  target_dir="$(osascript &lt;&lt;'APPLESCRIPT'
tell application "Finder"
  if (count of Finder windows) &gt; 0 then
    POSIX path of (target of front Finder window as alias)
  else
    POSIX path of (path to desktop folder as alias)
  end if
end tell
APPLESCRIPT
)"
fi

file_name="$(osascript &lt;&lt;'APPLESCRIPT'
text returned of (display dialog "Enter new file name with extension:" default answer "untitled.txt" buttons {"Cancel", "Create"} default button "Create")
APPLESCRIPT
)"

if [[ -z "$file_name" ]]; then
  exit 1
fi

if [[ "$file_name" == */* ]]; then
  osascript -e 'display alert "Invalid filename" message "Do not include / in the file name."'
  exit 1
fi

new_file="$target_dir/$file_name"

if [[ -e "$new_file" ]]; then
  osascript -e 'display alert "File already exists" message "A file or folder with this name already exists."'
  exit 1
fi

touch "$new_file"
open -R "$new_file"</string>
					<key>CheckedForUserDefaultShell</key>
